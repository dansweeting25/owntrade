<script is:inline>document.addEventListener('DOMContentLoaded', function(){ breakdanceForm.init('.bde-form-builder-139-113 .breakdance-form') }) </script>
<script is:inline>document.addEventListener('DOMContentLoaded', function(){ 
(function(){
  if (window.__otOnboard) return; window.__otOnboard = true;
  try { if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('ot-still'); } catch (e) {}

  /* ---- settings ---- */
  var DAN_EMAIL = 'dan@danielsweeting.com'; /* the Google account clients add as a manager */
  var TITLES = ['Your Web Address', 'Your Google Profile', 'Your Photos'];

  function $(s, r){ return Array.prototype.slice.call((r || document).querySelectorAll(s)); }

  function init(){
    var card = document.querySelector('.ot-welcome-card');
    var form = card && card.querySelector('form');
    if (!form) return;

    function input(name){ return form.querySelector('[name="fields[' + name + ']"], [name="fields[' + name + '][]"]'); }
    function wrapOf(name){ var el = input(name); return el ? el.closest('.breakdance-form-field') : null; }
    function blockOf(key){ var el = form.querySelector('[data-ob="' + key + '"]'); return el ? el.closest('.breakdance-form-field') : null; }
    function val(name){ var c = form.querySelector('[name="fields[' + name + '][]"]:checked, [name="fields[' + name + ']"]:checked'); return c ? c.value : ''; }

    /* ---- show only what applies to this client ---- */
    function is(name, v){ return function(){ return val(name) === v; }; }
    var rules = [
      [wrapOf('domain_existing'), is('domain_status', 'Already have one')],
      [wrapOf('domain_host'), is('domain_status', 'Already have one')],
      [blockOf('dc'), is('domain_status', 'Got one in mind')],
      [wrapOf('domain_choice'), is('domain_status', 'Got one in mind')],
      [blockOf('pick'), is('domain_status', 'Pick one for me')],
      [blockOf('gbp-have'), is('gbp_status', 'Got one')],
      [wrapOf('gbp_added'), is('gbp_status', 'Got one')],
      [blockOf('gbp-none'), is('gbp_status', "Haven't got one")],
      [wrapOf('gbp_address'), is('gbp_status', "Haven't got one")],
      [wrapOf('gbp_visit'), is('gbp_status', "Haven't got one")],
      [wrapOf('gbp_hours'), is('gbp_status', "Haven't got one")],
      [blockOf('gbp-unsure'), is('gbp_status', 'Not sure')],
      [wrapOf('photos'), is('photos_status', 'Adding now')],
      [blockOf('photos-later'), is('photos_status', 'Sending later')],
      [blockOf('photos-stock'), is('photos_status', 'Use stock photos')],
      [wrapOf('logo'), is('logo_status', 'Adding logo')]
    ];
    function apply(){
      rules.forEach(function(r){ if (r[0]) r[0].style.display = r[1]() ? '' : 'none'; });
      $('.breakdance-form-radio, .breakdance-form-checkbox', form).forEach(function(w){
        var i = w.querySelector('input'); w.classList.toggle('ot-choice-on', !!(i && i.checked));
      });
    }
    form.addEventListener('change', apply);

    /* ---- fill in what I already know from the link, e.g. /welcome/?name=Tom&business=Heritage&phone=07...&email=...&plan=ads ---- */
    var q = null; try { q = new URLSearchParams(location.search); } catch (e) {}
    function qp(k){ return q ? (q.get(k) || '') : ''; }
    var details = ['name', 'business', 'phone', 'email'], known = 0;
    details.forEach(function(k){ var el = input(k), v = qp(k); if (el && v) { el.value = v; known++; } });
    if (known === details.length) {
      /* I already have their details, so they only see the three steps */
      details.forEach(function(k){ var w = wrapOf(k); if (w) w.style.display = 'none'; });
      ['details', 'domain-kick'].forEach(function(k){ var b = blockOf(k); if (b) b.style.display = 'none'; });
    }
    var planEl = input('plan'), plan = qp('plan').toLowerCase();
    if (planEl) planEl.value = plan === 'ads' ? 'Site + Ads' : plan === 'site' ? 'Site only' : '';
    apply();

    /* ---- my email for the Google steps ---- */
    $('.ot-ob-email', form).forEach(function(e){ e.textContent = DAN_EMAIL; });
    $('.ot-copy-btn', form).forEach(function(b){
      b.addEventListener('click', function(){
        function done(){ b.textContent = 'Copied'; setTimeout(function(){ b.textContent = 'Copy My Email'; }, 2000); }
        function fallback(){
          var t = document.createElement('textarea'); t.value = DAN_EMAIL; t.setAttribute('readonly', '');
          t.style.position = 'fixed'; t.style.opacity = '0'; document.body.appendChild(t); t.select();
          try { document.execCommand('copy'); done(); } catch (e) {}
          t.remove();
        }
        if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(DAN_EMAIL).then(done, fallback); else fallback();
      });
    });

    /* ---- "not sure" search uses their business name and area ---- */
    $('.ot-gbp-search', form).forEach(function(a){
      a.addEventListener('click', function(){
        var b = (input('business') || {}).value || '', ar = qp('area');
        a.href = 'https://www.google.com/search?q=' + encodeURIComponent((b + ' ' + ar).trim() || 'my business');
      });
    });

    /* ---- domain checker (public registry lookup, no account needed) ---- */
    var dcInput = form.querySelector('.ot-dc-input'), dcBtn = form.querySelector('.ot-dc-btn'), dcOut = form.querySelector('.ot-dc-results'), choice = input('domain_choice');
    function clean(s){
      s = (s || '').toLowerCase().trim().replace(/^https?:\/\//, '').replace(/^www\./, '').split('/')[0];
      return s.replace(/\s+/g, '').replace(/[^a-z0-9.-]/g, '');
    }
    function candidates(s){ return s.indexOf('.') > -1 ? [s] : [s + '.co.uk', s + '.com', s + '.uk']; }
    function rdap(d){
      var tld = d.split('.').pop();
      if (tld === 'uk') return 'https://rdap.nominet.uk/uk/domain/' + d;
      if (tld === 'com' || tld === 'net') return 'https://rdap.verisign.com/' + tld + '/v1/domain/' + d;
      return 'https://rdap.org/domain/' + d;
    }
    function check(d){
      return fetch(rdap(d), { cache: 'no-store' }).then(function(r){
        if (r.status === 404) return 'free';
        if (r.ok) return 'taken';
        return 'unknown';
      }, function(){ return 'unknown'; });
    }
    function pick(d, b){
      if (choice) { choice.value = d; choice.dispatchEvent(new Event('input', { bubbles: true })); }
      $('.ot-dc-use', dcOut).forEach(function(x){ x.textContent = 'Use This'; x.classList.remove('ot-dc-chosen'); });
      b.textContent = 'Chosen'; b.classList.add('ot-dc-chosen');
    }
    function run(){
      if (!dcInput || !dcOut) return;
      var s = clean(dcInput.value);
      if (!/^[a-z0-9-]{2,}(\.[a-z0-9-]{2,})*$/.test(s)) { dcOut.innerHTML = '<p class="ot-dc-msg">Type a name to check, like <strong>wdroofing</strong>.</p>'; return; }
      var list = candidates(s);
      dcOut.innerHTML = '';
      dcBtn.disabled = true; dcBtn.textContent = 'Checking';
      var rows = list.map(function(d){
        var row = document.createElement('div'); row.className = 'ot-dc-item';
        row.innerHTML = '<span class="ot-dc-name"></span><span class="ot-dc-status">Checking…</span>';
        row.querySelector('.ot-dc-name').textContent = d;
        dcOut.appendChild(row); return row;
      });
      var unknown = 0;
      Promise.all(list.map(function(d, i){
        return check(d).then(function(st){
          var row = rows[i], el = row.querySelector('.ot-dc-status');
          if (st === 'free') {
            el.className = 'ot-dc-status ot-dc-free'; el.textContent = 'Available';
            var b = document.createElement('button'); b.type = 'button'; b.className = 'ot-dc-use'; b.textContent = 'Use This';
            b.addEventListener('click', function(){ pick(d, b); });
            row.appendChild(b);
          } else if (st === 'taken') {
            el.className = 'ot-dc-status'; el.textContent = 'Taken';
          } else {
            unknown++; el.className = 'ot-dc-status'; el.textContent = "I'll Check";
          }
        });
      })).then(function(){
        dcBtn.disabled = false; dcBtn.textContent = 'Check';
        if (unknown === list.length) {
          var p = document.createElement('p'); p.className = 'ot-dc-msg';
          p.textContent = "I couldn't check that just now. Type the one you'd like below and I'll check it for you.";
          dcOut.appendChild(p);
        }
      });
    }
    if (dcBtn) dcBtn.addEventListener('click', run);
    if (dcInput) dcInput.addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); run(); } });

    /* ---- the nut step header above the form ---- */
    var sh = card.querySelector('.ot-sh');
    /* the first washer screws in when the form comes into view, not off-screen */
    var seen = !('IntersectionObserver' in window);
    if (!seen && sh) {
      $('.ot-sh-on', sh).forEach(function(n){ n.classList.remove('ot-sh-on'); });
      var io = new IntersectionObserver(function(en){
        if (en[0].isIntersecting) { seen = true; io.disconnect(); syncStep(); }
      }, { threshold: 0.4 });
      io.observe(sh);
    }
    function syncStep(){
      if (!sh || !seen) return;
      var vis = form.querySelector('.breakdance-form-field[data-form-step]:not(.hidden-step)');
      var n = vis ? parseInt(vis.getAttribute('data-form-step'), 10) : (parseInt(form.getAttribute('data-current-step'), 10) || 1);
      var nEl = sh.querySelector('.ot-sh-n'); if (nEl) nEl.textContent = n;
      var t = sh.querySelector('.ot-sh-title'); if (t) t.textContent = TITLES[n - 1] || '';
      $('.ot-sh-nut', sh).forEach(function(img){
        var s = parseInt(img.getAttribute('data-sh-step'), 10);
        img.classList.toggle('ot-sh-on', s === n); img.classList.toggle('ot-sh-done', s < n);
      });
      $('.ot-sh-line', sh).forEach(function(l, i){ l.classList.toggle('ot-sh-line-on', i + 1 < n); });
    }
    if ('MutationObserver' in window) new MutationObserver(syncStep).observe(form, { attributes: true, subtree: true, attributeFilter: ['class', 'data-current-step'] });
    syncStep();

    /* ---- keep each new step (and the thank-you) in view on a phone ---- */
    function toTop(){
      setTimeout(function(){
        var r = card.getBoundingClientRect();
        if (r.top < 70 || r.top > window.innerHeight * 0.6) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 60);
    }
    form.addEventListener('click', function(e){
      if (e.target.closest('.breakdance-form-button__next-step, .breakdance-form-button__previous-step')) toTop();
    });
    if ('MutationObserver' in window) {
      var shown = false;
      new MutationObserver(function(){
        if (shown) return;
        if (card.querySelector('.breakdance-form-message--success')) { shown = true; if (sh) sh.style.display = 'none'; toTop(); }
      }).observe(card, { childList: true, subtree: true });
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();

 }) </script>
